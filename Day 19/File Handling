import java.io.FileWriter;

public class FileHandling {
    public static void main(String[] args) {
        try {
            FileWriter fw = new FileWriter("demo.txt");
            fw.write("Hello Java");
            fw.close();

            System.out.println("File created successfully");
        } catch (Exception e) {
            System.out.println(e);
        }
    }
}
